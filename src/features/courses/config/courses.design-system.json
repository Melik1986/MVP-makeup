{
  "designSystem": {
    "meta": {
      "projectName": "MVP Kosmetic",
      "section": "courses",
      "style": "Premium, Editorial, High Contrast"
    },
    "colorPalette": {
      "primary": {
        "100": "#FADBDD",
        "500": "#A81C26",
        "700": "#7A0F17",
        "900": "#2E0509"
      },
      "secondary": {
        "500": "#1B3F2B",
        "900": "#0D2115"
      },
      "neutral": {
        "white": "#FFFFFF",
        "gray50": "#F9F9F9",
        "gray200": "#E5E5E5",
        "gray800": "#333333",
        "black": "#000000"
      },
      "semantic": {
        "success": "#28A745",
        "warning": "#D4AF37",
        "error": "#E02020",
        "info": "#333333"
      },
      "background": {
        "primary": "#FFFFFF",
        "secondary": "#F9F9F9",
        "surface": "#FFFFFF"
      },
      "gradients": {
        "heroGradient": "linear-gradient(180deg, #1a0406 0%, #4a0e14 100%)",
        "buttonPrimary": "linear-gradient(180deg, #D65A61 0%, #9E1B23 100%)",
        "buttonShine": "radial-gradient(50% 100% at 50% 0%, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 100%)"
      }
    },
    "typography": {
      "fontFamilies": {
        "primary": "Montserrat, Helvetica, Arial, sans-serif",
        "secondary": "Playfair Display, serif",
        "monospace": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
      },
      "fontSizes": {
        "xs": "12px",
        "sm": "14px",
        "base": "16px",
        "lg": "18px",
        "xl": "24px",
        "2xl": "36px",
        "3xl": "48px",
        "hero": "120px"
      },
      "lineHeights": {
        "tight": "1.1",
        "normal": "1.5",
        "relaxed": "1.8"
      },
      "fontWeights": {
        "light": "300",
        "normal": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700",
        "black": "900"
      },
      "textStyles": {
        "sectionTitle": {
          "fontFamily": "Playfair Display, serif",
          "fontSize": "36px",
          "fontWeight": "400",
          "lineHeight": "1.1",
          "letterSpacing": "0.05em",
          "textTransform": "uppercase",
          "color": "#333333"
        },
        "cardTitle": {
          "fontFamily": "Playfair Display, serif",
          "fontSize": "48px",
          "fontWeight": "400",
          "lineHeight": "1.1",
          "letterSpacing": "0.02em",
          "color": "#333333"
        },
        "cardBody": {
          "fontFamily": "Montserrat, Helvetica, Arial, sans-serif",
          "fontSize": "14px",
          "fontWeight": "300",
          "lineHeight": "1.5",
          "letterSpacing": "0.02em",
          "color": "#333333"
        },
        "indexMarker": {
          "fontFamily": "Montserrat, Helvetica, Arial, sans-serif",
          "fontSize": "14px",
          "fontWeight": "300",
          "lineHeight": "1.1",
          "letterSpacing": "0.2em",
          "textTransform": "uppercase",
          "color": "#333333"
        }
      }
    },
    "spacing": {
      "scale": "linear",
      "baseUnit": "8px",
      "values": {
        "0": "0px",
        "1": "8px",
        "2": "16px",
        "3": "24px",
        "4": "32px",
        "6": "48px",
        "8": "64px",
        "12": "96px",
        "section": "120px"
      }
    },
    "borderRadius": {
      "none": "0px",
      "sm": "4px",
      "md": "8px",
      "lg": "16px",
      "full": "9999px"
    },
    "shadows": {
      "sm": "0 10px 20px rgba(0,0,0,0.08)",
      "md": "0 20px 40px rgba(0,0,0,0.12)",
      "glowPrimary": "0px 10px 20px rgba(166, 28, 38, 0.4), inset 0px 2px 4px rgba(255,255,255,0.3)"
    },
    "layout": {
      "grid": {
        "columns": "12",
        "gap": "32px",
        "maxWidth": "1140px"
      },
      "containers": {
        "sm": "640px",
        "md": "768px",
        "lg": "1024px",
        "xl": "1280px"
      }
    },
    "components": {
      "coursesSection": {
        "title": {
          "align": "center",
          "marginBottom": "64px"
        },
        "pinScene": {
          "minHeight": "100dvh",
          "pin": true,
          "scrub": 1
        }
      },
      "courseCard": {
        "base": {
          "width": "min(92vw, 760px)",
          "height": "min(72vh, 560px)",
          "padding": "64px",
          "borderRadius": "16px",
          "border": "1px solid rgba(51,51,51,0.08)",
          "boxShadow": "0 20px 40px rgba(0,0,0,0.08)"
        },
        "variants": {
          "light": {
            "background": "linear-gradient(180deg, rgba(255,255,255,0.92) 0%, #F9F9F9 100%)",
            "textColor": "#333333"
          },
          "dark": {
            "background": "linear-gradient(180deg, #1a0406 0%, #4a0e14 100%)",
            "textColor": "#FFFFFF",
            "mutedTextColor": "rgba(255,255,240,0.6)"
          }
        },
        "states": {
          "hover": {
            "transform": "translateY(-2px)",
            "boxShadow": "0 24px 60px rgba(0,0,0,0.12)"
          },
          "focus": {
            "outline": "2px solid #A81C26",
            "outlineOffset": "3px"
          }
        }
      }
    },
    "animations": {
      "transitions": {
        "fast": "150ms ease",
        "normal": "300ms ease",
        "slow": "500ms ease"
      },
      "commonEffects": [
        "Layered Pinning / Overlay on scroll with scrub: 1",
        "Previous card depth: scale 0.92 and opacity 0.55",
        "Progress line fill driven by ScrollTrigger progress"
      ],
      "easing": {
        "premiumOut": "expo.out"
      }
    },
    "iconography": {
      "style": "outline",
      "strokeWidth": "1.5",
      "defaultSize": "24px",
      "colors": {
        "primary": "#333333",
        "secondary": "#A81C26"
      }
    },
    "specificElements": {
      "indexCounter": {
        "format": "01/03",
        "placement": "bottom-right",
        "style": "editorial minimal"
      },
      "progressLine": {
        "height": "2px",
        "color": "rgba(51,51,51,0.12)",
        "activeColor": "#A81C26"
      }
    }
  }
}
